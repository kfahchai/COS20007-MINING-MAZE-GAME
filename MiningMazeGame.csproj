<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>MiningMaze</AssemblyName>
    <RootNamespace>MiningMaze</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SplashKit" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- tools/ holds the asset generator, tests/ holds headless logic tests -->
    <Compile Remove="tools/**;tests/**" />
    <None Include="Resources/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
